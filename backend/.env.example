SITE_NAME=ligastavok.ru

# Two odds per match (main 2-way line)
# Main 1X2: 921=home (1), 922=draw (X), 923=away (2)
FONBET_ODDS_FACTOR_IDS=921,922,923

# Fonbet line API
FONBET_LIST_LIGHT_URL=https://line-lb61-w.bk6bba-resources.com/ma/events/listLight?lang=en&place=live&scopeMarket=1600
FONBET_LIST_URL_BASE=https://line-lb54-w.bk6bba-resources.com/ma/events/list
FONBET_SCOPE_MARKET=1600
FONBET_LANG=en
POLL_INTERVAL_SECONDS=3.5
RETAIN_SNAPSHOT_YEARS=1

# PostgreSQL — project database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booker_adapter
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=booker_adapter
# DB_USER=postgres
# DB_PASSWORD=postgres

# Liga Stavok adapter
LIGASTAVOK_WS_URL=wss://lds-api-sites.ligastavok.ru/ws
LIGASTAVOK_SNAPSHOT_URL=https://lds-api-sites.ligastavok.ru/rest/events/v8/eventsList
LIGASTAVOK_WS_SUBSCRIBE_METHOD=/notifications/v3/eventUpdated
LIGASTAVOK_MAIN_MARKET_TYPE=WIN
# Comma-separated fallback order: WIN (1X2) then WIN2 (2-way)
LIGASTAVOK_MAIN_MARKET_TYPES=WIN,WIN2
LIGASTAVOK_OUTCOME_KEYS=_1,x,_2
LIGASTAVOK_APP_NAME=mobile
LIGASTAVOK_CURL_FILE=capture.curl
LIGASTAVOK_WS_ENABLED=true
LIGASTAVOK_POLL_INTERVAL_SECONDS=1.5
# Session cookies from DevTools (required if capture.curl has no -b line)
# LIGASTAVOK_COOKIE=qrator_jsid2=...; cfidsgib-w-ligastavok=...
# All live sports (Fonbet-style) — strips gameId from curl body, paginates until total
LIGASTAVOK_LIVE_ALL_SPORTS=true
# Snapshot namespace for shared defaults (live poll forces live; line package forces prematch)
# LIGASTAVOK_NS=live
# LIGASTAVOK_LINE_POLL_INTERVAL_SECONDS=10
# LIGASTAVOK_LINE_BROWSER_URL=https://www.ligastavok.ru/prematch
# LIGASTAVOK_LINE_BROWSER_CDP_URL=http://127.0.0.1:9222
# LIGASTAVOK_LINE_PRUNE_ABSENT=true
# LIGASTAVOK_LINE_PRUNE_MIN_FIXTURES=1
LIGASTAVOK_SNAPSHOT_LIMIT=160
LIGASTAVOK_SNAPSHOT_PARALLEL=true
LIGASTAVOK_SNAPSHOT_PARALLEL_WORKERS=6
# LIGASTAVOK_JSON_PRETTY=false
# LIGASTAVOK_PROFILE=true
LIGASTAVOK_SNAPSHOT_MAX_PAGES=0

# Playwright — auto-refresh Qrator cookies (recommended for continuous poll)
LIGASTAVOK_USE_PLAYWRIGHT=true
LIGASTAVOK_BROWSER_HEADLESS=false
LIGASTAVOK_BROWSER_URL=https://www.ligastavok.ru/live
LIGASTAVOK_BROWSER_TIMEOUT_SECONDS=90
LIGASTAVOK_BROWSER_REFRESH_RANGE=15-25
# Drop place=live rows missing from the latest full HTTP snapshot (default: on)
# LIGASTAVOK_LIVE_PRUNE_ABSENT=true
# LIGASTAVOK_LIVE_PRUNE_MIN_FIXTURES=1
# Or fixed interval: LIGASTAVOK_BROWSER_REFRESH_EVERY=12
# Reuse a logged-in browser profile (often still blocked by Qrator — prefer CDP below)
# LIGASTAVOK_BROWSER_PROFILE_DIR=.liga_browser_profile
# Attach to YOUR Chrome (best — no "automated test software" banner):
# LIGASTAVOK_BROWSER_CDP_URL=http://127.0.0.1:9222
# LIGASTAVOK_BROWSER_CHANNEL=chrome
# Auto-click welcome promo («Получить бонус»)
# LIGASTAVOK_PROMO_AUTO_CLICK=true
# LIGASTAVOK_PROMO_AUTO_CLICK_DELAY_SECONDS=1
# Disable browser cookie refresh: LIGASTAVOK_USE_PLAYWRIGHT=false
# Or CLI: python main.py poll ligastavok --no-browser

# Bet365 ZAP WebSocket (see backend/bet365/README.md)
# SITE_NAME=bet365.com
# BET365_SAFE_MODE=true
# BET365_POLL_INTERVAL_SECONDS=8
# BET365_BROWSER_AUTO_RELOAD=false
# BET365_BROWSER_INITIAL_ATTACH=true
# BET365_RECOVER_RELOAD=false
# BET365_STALE_POLLS_BEFORE_RECOVER=6
# BET365_WAIT_FOR_CLOUDFLARE=true
# BET365_CLOUDFLARE_WAIT_SECONDS=300
# BET365_CLOUDFLARE_AUTO_CLICK=true
# BET365_CLOUDFLARE_AUTO_CLICK_DELAY_SECONDS=30
# BET365_COOKIE_BANNER_AUTO_CLICK=true
# BET365_COOKIE_BANNER_DELAY_SECONDS=5
# BET365_IMPORT_ALL=true
# BET365_SKIP_ESOCCER=true
# BET365_WS_URL=wss://premws-pt1.365lpodds.com/zap/
# BET365_WS_UID=3528489557161243
# BET365_COOKIE=pstk=...; aps03=...
# BET365_SESSION_ID=
# BET365_NST_TOKEN=
# BET365_BROWSER_CDP_URL=http://127.0.0.1:9223
# BET365_USE_BROWSER=true
# BET365_BROWSER_ENTRY_URL=https://www.bet365.com/
# BET365_BROWSER_URL=https://www.bet365.com/#/HO/
#
# Bet365 line (prematch #/AO/) — separate Chrome on port 9225
# BET365_LINE_BROWSER_CDP_URL=http://127.0.0.1:9225
# BET365_LINE_BROWSER_URL=https://www.bet365.com/#/AO/
# BET365_LINE_BROWSER_ENTRY_URL=https://www.bet365.com/#/HO/
# BET365_LINE_COOKIE_IMPORT_CDP_URL=http://127.0.0.1:9223
# BET365_LINE_POLL_INTERVAL_SECONDS=15
# BET365_LINE_INITIAL_LOAD_SECONDS=90
# BET365_LINE_PRUNE_ABSENT=false
# BET365_LINE_SPORT_IDS=1,13,18,16,91,78,17,12,8,9,14,15,3,36,83


# Betcity live WebSocket (see backend/betcity_live/README.md)
# SITE_NAME=betcity.ru
BETCITY_WS_URL=wss://sc.betcity.ru/?id=live&csn=ooca9s
BETCITY_ORIGIN=https://betcity.ru
# BETCITY_REFERER=https://betcity.ru/
# BETCITY_COOKIE=
# BETCITY_LISTEN_SECONDS=30
# BETCITY_POLL_INTERVAL_SECONDS=3.5
BETCITY_CATALOG_URL=https://ad.betcity.ru/d/on_air/events
# BETCITY_CATALOG_REFRESH_SECONDS=30
# CDP Chrome (port 9224) — use with --browser when you need a proxy IP
# BETCITY_USE_BROWSER=true
# BETCITY_BROWSER_CDP_URL=http://127.0.0.1:9224
# BETCITY_BROWSER_URL=https://betcity.ru/ru/live
# BETCITY_BROWSER_TIMEOUT_SECONDS=60
# BETCITY_PROXY=1.2.3.4:8080
# BETCITY_ODDS_FACTOR_IDS=921,922,923
# BETCITY_MAIN_MARKET_ID=69
# BETCITY_MAIN_BLOCK=Wm

# Betcity line (prematch) HTTP — see backend/betcity_line/README.md
# BETCITY_LINE_URL=https://ad.betcity.ru/d/off/events
# BETCITY_LINE_REV=6
# BETCITY_LINE_VER=82
# BETCITY_LINE_CSN=ooca9s
# BETCITY_LINE_POLL_INTERVAL_SECONDS=10
# BETCITY_LINE_HTTP_TIMEOUT=90
# BETCITY_LINE_CONNECT_TIMEOUT=60

# 1xBet line HTTP — see backend/lxbet_line/README.md
# LXBET_LINE_EVENTS_URL=https://1xlite-55157.pro/service-api/LineFeed/Get1x2_VZip
# LXBET_LINE_SPORTS_URL=https://1xlite-55157.pro/service-api/LineFeed/GetSportsShortZip
# LXBET_LINE_CHAMPS_URL=https://1xlite-55157.pro/service-api/LineFeed/GetChampsZip
# LXBET_LINE_SPORT_COUNT=50
# LXBET_LINE_FETCH_ALL_SPORTS=true
# LXBET_LINE_FETCH_TOP=true
# LXBET_LINE_MAX_WORKERS=1
# LXBET_LINE_REQUEST_PAUSE_SECONDS=1.0
# LXBET_LINE_HTTP_TIMEOUT=60
# LXBET_LINE_SKIP_SPORT_IDS=314,176
# Sidebar sports (Football, Ice Hockey, Basketball, Tennis, Baseball,
# Volleyball, Table Tennis, Badminton, Esports). Empty = all sports.
# LXBET_LINE_ONLY_SPORT_IDS=1,2,3,4,5,6,10,16,40
# Prune missing matches only when catalog coverage is high enough (keeps recent data
# if the mirror times out mid-fetch). Past kickoffs are dropped after N hours.
# LXBET_LINE_PRUNE_COVERAGE_MIN=0.9
# LXBET_LINE_PRUNE_PAST_HOURS=48
# LXBET_LINE_POLL_INTERVAL_SECONDS=90
# LXBET_LINE_LNG=en
# LXBET_LINE_MODE=4
# LXBET_LINE_COUNTRY=179
# LXBET_ODDS_FACTOR_IDS=921,922,923

# 1xBet live HTTP — see backend/lxbet_live/README.md
# LXBET_LIVE_EVENTS_URL=https://1xlite-55157.pro/service-api/LiveFeed/Get1x2_VZip
# LXBET_LIVE_SPORTS_URL=https://1xlite-55157.pro/service-api/LiveFeed/GetSportsShortZip
# LXBET_LIVE_CHAMPS_URL=https://1xlite-55157.pro/service-api/LiveFeed/GetChampsZip
# LXBET_LIVE_SPORT_COUNT=50
# Full catalog in one cycle (same strategy as lxbet_line).
# LXBET_LIVE_FETCH_ALL_SPORTS=true
# LXBET_LIVE_FETCH_TOP=true
# LXBET_LIVE_MAX_WORKERS=1
# LXBET_LIVE_REQUEST_PAUSE_SECONDS=0.5
# LXBET_LIVE_HTTP_TIMEOUT=60
# Empty ONLY = all sports from GetSportsShortZip.
# LXBET_LIVE_ONLY_SPORT_IDS=
# LXBET_LIVE_SKIP_SPORT_IDS=314,176
# LXBET_LIVE_PRUNE_COVERAGE_MIN=0.9
# LXBET_LIVE_POLL_INTERVAL_SECONDS=10
# LXBET_LIVE_GR=1197
# LXBET_LIVE_LNG=en
# LXBET_LIVE_MODE=4
# LXBET_LIVE_COUNTRY=179
# LXBET_LIVE_NO_FILTER_BLOCK_EVENT=true
